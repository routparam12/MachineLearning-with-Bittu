---
/* Same fixed glass pill as every other section: language switch + sound,
   music and theme toggles. RAG only ever has one page per locale, so the
   language links are plain hrefs rather than a swapLang() helper. */
const { locale, t } = Astro.props;
const ui = t?.ui || {};
---
<div class="toolbar" data-toolbar data-labels={JSON.stringify(ui)}>
  <div class="lang" role="group" aria-label="Language">
    <a href="/en/rag/" class="lang__opt" data-lang="en" aria-pressed={locale === 'en' ? 'true' : 'false'}>EN</a>
    <a href="/hi/rag/" class="lang__opt" data-lang="hi" aria-pressed={locale === 'hi' ? 'true' : 'false'}>HI</a>
  </div>
  <button class="pill" data-sfx-toggle type="button" aria-pressed="true" aria-label={ui.turnSfxOff || 'Turn sound off'}>
    <span data-icon-on>🔊</span><span data-icon-off hidden>🔇</span>
  </button>
  <button class="pill" data-music-toggle type="button" aria-pressed="false" aria-label={ui.turnMusicOn || 'Turn music on'}>
    <span data-icon-on hidden>🎬</span><span data-icon-off>🎼</span>
  </button>
  <button class="pill" data-theme-toggle type="button" aria-pressed="false" aria-label={ui.themeLight || 'Switch to light theme'}>
    <span data-icon-on hidden>☀️</span><span data-icon-off>🌙</span>
  </button>
</div>

<style>
  .toolbar {
    position: fixed; top: clamp(8px, 1.6vw, 16px); right: clamp(8px, 2vw, 20px);
    z-index: 60; display: flex; align-items: center; gap: 8px;
    background: rgba(20, 27, 22, .78);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 6px; backdrop-filter: blur(6px);
  }
  :root[data-theme="light"] .toolbar { background: rgba(255, 250, 240, .85); }

  .lang {
    display: flex; background: var(--bg); border-radius: 999px; overflow: hidden;
    border: 1px solid var(--line);
  }
  .lang__opt {
    font-family: var(--mono); font-size: 12px; font-weight: 700; letter-spacing: .04em;
    padding: 7px 12px; color: var(--ink); text-decoration: none; cursor: pointer;
  }
  .lang__opt[aria-pressed="true"] { background: var(--teal); color: var(--bg); }

  .pill {
    display: grid; place-items: center; width: 34px; height: 34px;
    border-radius: 50%; border: 1px solid var(--line); background: var(--bg);
    cursor: pointer; font-size: 15px; padding: 0; line-height: 1;
    transition: transform .12s ease;
  }
  .pill:hover { transform: scale(1.08); }
  .pill[aria-pressed="false"] { opacity: .55; }

  @media (max-width: 620px) {
    .toolbar { top: 8px; right: 8px; padding: 5px; gap: 6px; }
    .pill { width: 30px; height: 30px; font-size: 13px; }
    .lang__opt { padding: 6px 9px; font-size: 11px; }
  }
</style>

<script>
  import { resumeAudio, sfxEnabled, musicEnabled, setSfxEnabled, setMusicEnabled, playPop } from '../../../shared/scripts/audio.js';

  const THEME_KEY = 'bittu-theme';
  const bar = document.querySelector('[data-toolbar]');
  const labels = JSON.parse(bar?.dataset.labels || '{}');

  const sfxBtn = document.querySelector('[data-sfx-toggle]');
  const musicBtn = document.querySelector('[data-music-toggle]');
  const themeBtn = document.querySelector('[data-theme-toggle]');

  function paintSfx(on) {
    sfxBtn.setAttribute('aria-pressed', String(on));
    sfxBtn.setAttribute('aria-label', on ? (labels.turnSfxOff || 'Turn sound off') : (labels.turnSfxOn || 'Turn sound on'));
    const onIcon = sfxBtn.querySelector('[data-icon-on]');
    const offIcon = sfxBtn.querySelector('[data-icon-off]');
    onIcon.hidden = !on;
    offIcon.hidden = on;
  }

  function paintMusic(on) {
    musicBtn.setAttribute('aria-pressed', String(on));
    musicBtn.setAttribute('aria-label', on ? (labels.turnMusicOff || 'Turn music off') : (labels.turnMusicOn || 'Turn music on'));
    const onIcon = musicBtn.querySelector('[data-icon-on]');
    const offIcon = musicBtn.querySelector('[data-icon-off]');
    onIcon.hidden = !on;
    offIcon.hidden = on;
  }

  function paintTheme(isLight) {
    themeBtn.setAttribute('aria-pressed', String(isLight));
    themeBtn.setAttribute('aria-label', isLight ? (labels.themeDark || 'Switch to dark theme') : (labels.themeLight || 'Switch to light theme'));
    const onIcon = themeBtn.querySelector('[data-icon-on]');
    const offIcon = themeBtn.querySelector('[data-icon-off]');
    onIcon.hidden = !isLight;
    offIcon.hidden = isLight;
  }

  paintSfx(sfxEnabled());
  paintMusic(musicEnabled());

  const savedTheme = localStorage.getItem(THEME_KEY);
  const isLight = savedTheme === 'light';
  document.documentElement.dataset.theme = isLight ? 'light' : 'dark';
  paintTheme(isLight);

  sfxBtn.addEventListener('click', () => {
    const next = sfxBtn.getAttribute('aria-pressed') !== 'true';
    setSfxEnabled(next);
    paintSfx(next);
    if (next) { resumeAudio(); playPop(); }
  });

  musicBtn.addEventListener('click', () => {
    const next = musicBtn.getAttribute('aria-pressed') !== 'true';
    resumeAudio();
    setMusicEnabled(next);
    paintMusic(next);
  });

  themeBtn.addEventListener('click', () => {
    const next = themeBtn.getAttribute('aria-pressed') !== 'true';
    document.documentElement.dataset.theme = next ? 'light' : 'dark';
    localStorage.setItem(THEME_KEY, next ? 'light' : 'dark');
    paintTheme(next);
    window.dispatchEvent(new CustomEvent('bittu-theme-change'));
  });
</script>
