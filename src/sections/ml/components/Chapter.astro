---
const { n, eyebrow, title, next, nextLabel = 'Next: chapter', nextText } = Astro.props;
---
<section class="chapter wrap" data-chapter={n} id={`ch${n}`}>
  <p class="chapter__eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  <slot />
  {next && <button class="btn next-btn" data-next={next}>{nextText || `${nextLabel} ${next}`} →</button>}
</section>
