---
import BaseLayout from '../../../sections/pytorch/Layout.astro';
import { langPaths, type Lang } from '../../../sections/pytorch/i18n';

export const getStaticPaths = langPaths;

const lang = Astro.params.lang as Lang;
---
<BaseLayout lang={lang}>
  <div id="app" data-lang={lang} data-home={`/${lang}/`}></div>
</BaseLayout>

<script>
  import { mount } from '../../../sections/pytorch/scripts/ui.js';

  const el = document.querySelector('#app');
  if (el) {
    const dict = el.dataset.lang === 'hi'
      ? (await import('../../../sections/pytorch/i18n/hi')).hi
      : (await import('../../../sections/pytorch/i18n/en')).en;
    mount(el, dict);
  }
</script>
